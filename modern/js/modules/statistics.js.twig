
console.log('');
$("#domain_stats").change(function () {
    if($("#domain_stats").val()!=''){
        $("#frecuen").attr('disabled',false);
        $("#file").attr('disabled',true);
        $("#frecuen").removeClass('disabled');
        $("#file").html('');
        $("#file").addClass('disabled');

    }else{
        $("#frecuen").attr('disabled',true);
        $("#file").attr('disabled',true);
        $("#frecuen").addClass('disabled');
        $("#file").html('');
        $("#file").addClass('disabled');
    }
});
$("#frecuen").change(function () {
    if($("#frecuen").val()!=''){
        $("#file").html('<option>loading...!</option>');
        $.ajaxSetup({ headers: { 'csrftoken' : '{{ tokenajax }}' } });
        $.ajax({
            type: "POST",
            url: "./{{users}}/index.php?module=statistics&acc=files",
            data:"domain="+$("#domain_stats").val()+"&frecuen="+$("#frecuen").val(),
            complete: function(datos){
                console.log(datos.responseText);
                var obj =JSON.parse(datos.responseText);
                if(obj.status!="OK"){
                    $("#file").html('');
                    if(obj.cod=="10001"){
                        var mjs ='{{langmod.SLABEL17}}';
                    }else if(obj.cod=="10002"){
                        var mjs ='{{langmod.SLABEL18}}';
                    }
                    noti_bubble(mjs,'{{langmod.SLABEL11}}','error',false,false,'3000',true);
                }else if(obj.status=="OK"){
                    $("#file").html(obj.sel);
                    $("#file").attr('disabled',false);
                    $("#file").removeClass('disabled');
                }
                return false;
            }
        });
    }else{
        $("#file").attr('disabled',true);
        $("#file").html('');
        $("#file").addClass('disabled');
    }
});
$("#file").change(function () {
    if($("#file").val()!=''){
        $("#btn-generate").removeClass('disabled');
        $("#btn-generate").attr('disabled',false);
    }else{
        $("#btn-generate").addClass('disabled');
        $("#btn-generate").attr('disabled',true);
    }
});
$("#btn-generate").click(function () {
    window.open('?module=statistics&view=1&domain='+$("#domain_stats").val()+'&frecuen='+$("#frecuen").val()+'&file='+$("#file").val(), 'statistics','_blank');
});
$("#mdomains").change(function (){
    if($("#mdomains").val()==''){
        $("#mfrequancy").attr('disabled',true);
        $("#mfrequancy").addClass('disabled');

        $("#mdate").attr('disabled',true);
        $("#mdate").addClass('disabled');

        $("#btndelete").attr('disabled',true);
        $("#btndelete").addClass('disabled');

    }else{
        $("#mfrequancy").attr('disabled',false);
        $("#mfrequancy").removeClass('disabled');
        $("#frecuen").attr('disabled',true);
        $("#file").attr('disabled',true);
        $("#frecuen").addClass('disabled');
        $("#file").html('');
        $("#file").addClass('disabled');
    }
    return false;
});
$("#mfrequancy").change(function (){
    if($("#mfrequancy").val()==''){
        $("#mdate").attr('disabled',true);
        $("#mdate").addClass('disabled');
        $("#btndelete").attr('disabled',true);
        $("#btndelete").addClass('disabled');
    }else{
        $.ajax({
            type: "POST",
            url: "./{{users}}/index.php?module=statistics&acc=getFilesDelete",
            data:"domain="+$("#mdomains").val()+"&frecuen="+$("#mfrequancy").val(),
            complete: function(datos){
                console.log(datos.responseText);
                var obj = JSON.parse(datos.responseText);
                $("#mdate").html('<option value="">Choose</option>'+obj.files+'<option value="ALL">ALL</option>');
                $("#mdate").attr('disabled',false);
                $("#mdate").removeClass('disabled');
                return false;
            }
        });
    }
    return false;
});
$("#mdate").change(function (){
    if($("#mdate").val()==''){
        $("#btndelete").attr('disabled',true);
        $("#btndelete").addClass('disabled');
    }else{
        $("#btndelete").attr('disabled',false);
        $("#btndelete").removeClass('disabled');
    }
    return false;
});
$("#btndelete").click(function (){
    $("#btndelete").attr('disabled',true);
    $("#btndelete").addClass('disabled');
    $.ajax({
        type: "POST",
        data: "domain="+$("#mdomains").val()+"&frequancy="+$("#mfrequancy").val()+"&file="+$("#mdate").val(),
        url: "./{{users}}/index.php?module=statistics&acc=filesDelete",
        complete: function(datos){
            console.log(datos.responseText);
            $.ajax({
                type: "POST",
                url: "./{{users}}/index.php?module=statistics&acc=getFilesDelete",
                data:"domain="+$("#mdomains").val()+"&frecuen="+$("#mfrequancy").val(),
                complete: function(datos){
                    var obj = JSON.parse(datos.responseText);
                    $("#mdate").html('<option value="">Choose</option>'+obj.files+'<option value="ALL">ALL</option>');
                    $("#mdate").attr('disabled',false);
                    $("#mdate").removeClass('disabled');
                    $("#btndelete").attr('disabled',false);
                    $("#btndelete").removeClass('disabled');
                    return false;
                }
            });
            return false;
        }
    });
});
/* ----- Live access/error log monitor (statistics module) -----
   Reuses the server-validated error_log endpoint (module=error_log&acc=select ->
   bounded tail of the selected domain's /usr/local/apache/domlogs/<domain>.{log,error.log}).
   Domains come server-rendered from mod.domains; polling runs only while the tab is visible. */
var statLive = { timer:null, busy:false, lines:200, interval:5000 };
function statLiveStatus(t){ $('#stat_live_status').text(t||''); }
function statLiveFetch(){
    var domain=$('#stat_live_domain').val(), tipe=$('#stat_live_tipe').val();
    if(!domain || statLive.busy){ return; }
    statLive.busy=true; statLiveStatus('{{ langene.LIVELOGUPDATING|default("Updating…") }}');
    $.ajaxSetup({ headers:{ 'csrftoken':'{{ tokenajax }}' } });
    $.ajax({ type:"POST", url:"./{{users}}/index.php?module=error_log&acc=select",
        data:"op=select&domain="+encodeURIComponent(domain)+"&tipe="+encodeURIComponent(tipe)+"&numline="+statLive.lines+"&textsearch=",
        complete:function(d){
            statLive.busy=false;
            var out=$('#stat_live_out')[0];
            var atBottom= out ? (out.scrollTop+out.clientHeight >= out.scrollHeight-20) : true;
            var text='';
            try { text=decodeURIComponent(escape(atob(d.responseText))); } catch(e){ try{ text=atob(d.responseText); }catch(e2){ text=''; } }
            text=(text||'').replace(/<br\s*\/?>/gi,'\n');
            var tmp=document.createElement('textarea'); tmp.innerHTML=text; text=tmp.value;
            if(text.trim()===''){ text='{{ langene.LIVELOGEMPTY|default("Log is empty.") }}'; }
            $('#stat_live_out').text(text);
            if(out && atBottom){ out.scrollTop=out.scrollHeight; }
            statLiveStatus('{{ langene.LIVELOGLAST|default("Last update") }}: '+new Date().toLocaleTimeString());
        }
    });
}
function statLiveStop(){ if(statLive.timer){ clearInterval(statLive.timer); statLive.timer=null; } $('#stat_live_dot').hide(); }
function statLiveStart(){ statLiveStop(); if(!$('#stat_live_auto').is(':checked') || !$('#stat_live_domain').val()){ return; } $('#stat_live_dot').show(); statLive.timer=setInterval(function(){ if(document.hidden){ return; } statLiveFetch(); }, statLive.interval); }
$('#stat_live_domain,#stat_live_tipe').change(function(){ statLiveFetch(); statLiveStart(); });
$('#stat_live_refresh').click(function(){ statLiveFetch(); });
$('#stat_live_auto').change(function(){ if($(this).is(':checked')){ statLiveFetch(); } statLiveStart(); });
document.addEventListener('visibilitychange', function(){ if(document.hidden){ statLiveStop(); } else if($('#stat_live_auto').is(':checked') && $('#stat_live_domain').val()){ statLiveFetch(); statLiveStart(); } });
